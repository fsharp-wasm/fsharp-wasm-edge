(module
  (type $str (array (mut i32)))
  (memory (export "memory") 1)
  (global $heap (mut i32) (i32.const 1024))
  ;; the allocator the canonical ABI asks for: a bump allocator, aligned
  (func $realloc (export "cabi_realloc") (param $old i32) (param $oldsz i32) (param $align i32) (param $size i32) (result i32)
    (local $p i32)
    (local.set $p (i32.and (i32.add (global.get $heap) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
    (global.set $heap (i32.add (local.get $p) (local.get $size)))
    ;; grow the memory to hold it
    (if (i32.gt_u (global.get $heap) (i32.shl (memory.size) (i32.const 16)))
      (then (drop (memory.grow (i32.add (i32.shr_u (i32.sub (global.get $heap) (i32.shl (memory.size) (i32.const 16))) (i32.const 16)) (i32.const 1))))))
    (local.get $p))
  ;; the canonical ABI calls this after the host has read the result: the arena starts over
  (func (export "cabi_post_greet") (param i32) (global.set $heap (i32.const 1024)))
  ;; the program: strings are GC arrays of UTF-16 code units (as in fsharp-wasm: $WasmStr = array i32)
  (func $greet (param $name (ref null $str)) (result (ref null $str))
    (local $out (ref null $str)) (local $n i32)
    (local.set $n (array.len (local.get $name)))
    (local.set $out (array.new_default $str (i32.add (local.get $n) (i32.const 7))))
    ;; "Hello, "
    (array.set $str (local.get $out) (i32.const 0) (i32.const 72))  (array.set $str (local.get $out) (i32.const 1) (i32.const 101))
    (array.set $str (local.get $out) (i32.const 2) (i32.const 108)) (array.set $str (local.get $out) (i32.const 3) (i32.const 108))
    (array.set $str (local.get $out) (i32.const 4) (i32.const 111)) (array.set $str (local.get $out) (i32.const 5) (i32.const 44))
    (array.set $str (local.get $out) (i32.const 6) (i32.const 32))
    (array.copy $str $str (local.get $out) (i32.const 7) (local.get $name) (i32.const 0) (local.get $n))
    (local.get $out))
  ;; the adapter the compiler would generate: lift the argument, call, lower the result  (string-encoding=utf16: no transcoding)
  (func (export "greet") (param $ptr i32) (param $len i32) (result i32)
    (local $in (ref null $str)) (local $out (ref null $str)) (local $i i32) (local $n i32) (local $dst i32) (local $ret i32)
    (local.set $in (array.new_default $str (local.get $len)))
    (loop $l1 (if (i32.lt_u (local.get $i) (local.get $len)) (then
      (array.set $str (local.get $in) (local.get $i) (i32.load16_u (i32.add (local.get $ptr) (i32.shl (local.get $i) (i32.const 1)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l1))))
    (local.set $out (call $greet (local.get $in)))
    (local.set $n (array.len (local.get $out)))
    (local.set $dst (call $realloc (i32.const 0) (i32.const 0) (i32.const 2) (i32.shl (local.get $n) (i32.const 1))))
    (local.set $i (i32.const 0))
    (loop $l2 (if (i32.lt_u (local.get $i) (local.get $n)) (then
      (i32.store16 (i32.add (local.get $dst) (i32.shl (local.get $i) (i32.const 1))) (array.get $str (local.get $out) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l2))))
    (local.set $ret (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
    (i32.store (local.get $ret) (local.get $dst))
    (i32.store offset=4 (local.get $ret) (local.get $n))
    (local.get $ret)))
